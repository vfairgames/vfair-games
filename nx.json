{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "tui": {
    "enabled": true
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "deploy-web": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "vercel --cwd dist/apps/$NX_TASK_TARGET_PROJECT --scope $VERCEL_SCOPE --project $NX_TASK_TARGET_PROJECT"
      },
      "configurations": {
        "production": {
          "command": "vercel --cwd dist/apps/$NX_TASK_TARGET_PROJECT --scope $VERCEL_SCOPE --project $NX_TASK_TARGET_PROJECT --prod"
        }
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "VERSION=\"${VERSION:-$(git rev-parse --short HEAD)}\" && docker buildx build --platform linux/amd64 --load -f docker/$NX_TASK_TARGET_PROJECT.Dockerfile -t vfair-$NX_TASK_TARGET_PROJECT:latest -t vfair-$NX_TASK_TARGET_PROJECT:$VERSION ."
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "VERSION=\"${VERSION:-$(git rev-parse --short HEAD)}\" && docker tag vfair-$NX_TASK_TARGET_PROJECT:latest $DOCKER_REGISTRY/vfair-$NX_TASK_TARGET_PROJECT:latest && docker tag vfair-$NX_TASK_TARGET_PROJECT:$VERSION $DOCKER_REGISTRY/vfair-$NX_TASK_TARGET_PROJECT:$VERSION && docker push $DOCKER_REGISTRY/vfair-$NX_TASK_TARGET_PROJECT:latest && docker push $DOCKER_REGISTRY/vfair-$NX_TASK_TARGET_PROJECT:$VERSION"
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "testTargetName": "test",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      },
      "exclude": ["apps/fake-partner-web/**/*"]
    },
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps",
        "serveStaticTargetName": "serve-static"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "exclude": ["apps/fake-partner-api/**/*"]
    }
  ],
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "css",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "eslint",
        "unitTestRunner": "vitest"
      }
    }
  }
}
